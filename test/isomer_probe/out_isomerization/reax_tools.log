[run]
schema_version = 2.1
program = ReaxTools
version = 2.3
identity_model = canonical-smiles-v1
smiles_model = reax-canonical-v1
command = ./bin/reax_tools_core -f test/isomer_probe/isomerization_ethanol_to_dme.xyz -o test/isomer_probe/out_isomerization -nt 1
input = test/isomer_probe/isomerization_ethanol_to_dme.xyz
output_dir = test/isomer_probe/out_isomerization
elapsed_s = 0.022788
frames = 2
atoms_first_frame = 9
atoms_last_frame = 9

[parameters]
vdw_scale = 1.200000
threads = 1
max_neighbors = 10
rings = enabled
reaction_events = enabled
transfer_flow = enabled
stable_time = 3
timestep_fs = 0.250000
sampling_freq = 10
smiles_max_atoms = 200

[results]
species = 2
formulas = 1
events = 1
transfer_edges = 1

[outputs]
species_count.csv
bond_count.csv
atom_bonded_num_count.csv
ring_count.csv
reaction_events.csv
reaction_event_pairs.csv
transfer_flow.csv
molecules.csv
reax_tools.log

[validation]
audit_basis = raw atom-overlap transfer events
status = generated audit-ready raw outputs
